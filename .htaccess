<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-HTTP-Method-Override"
</IfModule>

<Limit GET POST PUT DELETE HEAD OPTIONS>
    Order Allow,Deny
    Allow from all
</Limit>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle OPTIONS preflight requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]

    # Proxy all requests to Next.js Node.js server (port 3000)
    # This ensures /api/* and all Next.js routes are handled by Node
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L,QSA]
</IfModule>
