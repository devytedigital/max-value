rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rules for Branch Network Collection
    match /branches/{branchId} {
      // Anyone can query, read, and write branch documents (write operations routed and sanitized via Next.js secure API endpoints)
      allow read, write: if true;
    }

    // Rules for Career Jobs Collection
    match /jobs/{jobId} {
      // Anyone can query and read jobs, and write actions are managed via secure server API routes
      allow read, write: if true;
    }

    // Rules for Media Collection
    match /media/{mediaId} {
      // Anyone can read and write media, writes are validated in API handlers
      allow read, write: if true;
    }

    // Rules for Videos Collection
    match /videos/{videoId} {
      // Anyone can read and write videos, writes are validated in API handlers
      allow read, write: if true;
    }

    // Rules for Documents Collection
    match /documents/{documentId} {
      // Anyone can read and write documents, writes are validated in API handlers
      allow read, write: if true;
    }

    // Rules for News Collection
    match /news/{newsId} {
      // Anyone can query and read news articles, writes are managed via secure server API routes
      allow read, write: if true;
    }

    // Rules for Blogs Collection
    match /blogs/{blogId} {
      // Anyone can query and read blog posts, writes are managed via secure server API routes
      allow read, write: if true;
    }

    // Rules for Gold Rate Collection
    match /gold-rate/{id} {
      // Anyone can query and read gold rates, writes are managed via secure server API routes
      allow read, write: if true;
    }

    // Rules for Admins Collection
    match /admins/{adminId} {
      // Managed and sanitized via secure server API routes
      allow read, write: if true;
    }

    // Rules for Directors Collection
    match /directors/{directorId} {
      // Anyone can query and read directors, writes are managed via secure server API routes
      allow read, write: if true;
    }

    // Default fallback: lock down all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
